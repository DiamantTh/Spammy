=== Full header ===
{% for line in metadata.raw_headers -%}
{{ line }}
{% endfor %}

=== Header analysis ===
Subject       : {{ metadata.subject }}
From          : {{ metadata.sender }}
To            : {{ metadata.recipient }}
Date observed : {{ metadata.date or "unknown" }}
Origin IP     : {{ result.candidate_ip or "unknown" }}
Network owner : {{ rdap.owner.name if rdap and rdap.owner else "unknown" }}
Registrar     : {{ domain.registrar if domain and domain.registrar else "n/a" }}

Received chain:
{% if result.received_hops -%}
{% for hop in result.received_hops %}- {{ hop.raw }}
{% endfor -%}
{% else -%}
- none
{% endif %}

=== DNS / MX checks ===
Reverse DNS   : {{ result.dns_checks.reverse_dns if result.dns_checks.reverse_dns else ("error (" ~ result.dns_checks.reverse_error ~ ")" if result.dns_checks.reverse_error else "n/a") }}
MX records    : {{ result.dns_checks.mx_records | join(", ") if result.dns_checks.mx_records else ("error (" ~ result.dns_checks.mx_error ~ ")" if result.dns_checks.mx_error else "none") }}
SPF record    : {{ "present" if result.dns_checks.spf_present is sameas true else ("not found" if result.dns_checks.spf_present is sameas false else ("error (" ~ result.dns_checks.spf_error ~ ")" if result.dns_checks.spf_error else "unknown")) }}
Blocklist hits: {{ result.dns_checks.blocklist_hits | join(", ") if result.dns_checks.blocklist_hits else ("error (" ~ result.dns_checks.blocklist_error ~ ")" if result.dns_checks.blocklist_error else "none") }}

=== Body analysis ===
URLs:
{% if result.body_indicators.urls -%}
{% for url in result.body_indicators.urls %}- {{ url }}
{% endfor -%}
{% else -%}
- none
{% endif %}

Domains:
{% if result.body_indicators.domains -%}
{% for dom in result.body_indicators.domains %}- {{ dom }}
{% endfor -%}
{% else -%}
- none
{% endif %}

IPs:
{% if result.body_indicators.ips -%}
{% for ip in result.body_indicators.ips %}- {{ ip }}
{% endfor -%}
{% else -%}
- none
{% endif %}

=== Body link owners ===
{% if result.body_link_details -%}
{% for detail in result.body_link_details %}- {{ detail.domain or detail.url }}
  Resolved IPs: {{ detail.resolved_ips | join(", ") or "n/a" }}
  Registrar: {{ detail.domain_record.registrar if detail.domain_record and detail.domain_record.registrar else "n/a" }}
  IP owners: {{ detail.ip_owner_names | join(", ") if detail.ip_owner_names else "n/a" }}
  {{ "Warning: HTTP link (no TLS)" if not detail.uses_https else "" }}

{% endfor -%}
{% else -%}
- none
{% endif %}

=== Authentication ===
SPF  : {{ result.auth_summary.spf.result or "unknown" }} ({{ result.auth_summary.spf.identity or result.auth_summary.spf.detail or "n/a" }})
DKIM : {{ result.auth_summary.dkim.result or "unknown" }} ({{ result.auth_summary.dkim.identity or result.auth_summary.dkim.detail or "n/a" }})
DMARC: {{ result.auth_summary.dmarc.result or "unknown" }} ({{ result.auth_summary.dmarc.identity or result.auth_summary.dmarc.detail or "n/a" }})

=== Abuse contacts ===
{% if contacts -%}
{% for contact in contacts %}- {{ contact.address }} (confidence {{ "%0.0f"|format(contact.confidence * 100) }} %)
{% endfor -%}
{% else -%}
- none detected
{% endif %}
