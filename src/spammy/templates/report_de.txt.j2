=== Vollständiger Header ===
{% for line in metadata.raw_headers -%}
{{ line }}
{% endfor %}

=== Kopfzeilenanalyse ===
Betreff        : {{ metadata.subject }}
Absender       : {{ metadata.sender }}
Empfänger      : {{ metadata.recipient }}
Empfangszeit   : {{ metadata.date or "unbekannt" }}
Mutmaßliche IP : {{ result.candidate_ip or "unbekannt" }}
Netzbetreiber  : {{ (rdap.owner.name if rdap and rdap.owner else "unbekannt") }}
Registrar      : {{ domain.registrar if domain and domain.registrar else "k. A." }}

Received-Kette:
{% if result.received_hops -%}
{% for hop in result.received_hops %}- {{ hop.raw }}
{% endfor -%}
{% else -%}
- keine
{% endif %}

=== DNS- / MX-Prüfungen ===
Reverse DNS   : {{ result.dns_checks.reverse_dns if result.dns_checks.reverse_dns else ("Fehler (" ~ result.dns_checks.reverse_error ~ ")" if result.dns_checks.reverse_error else "k. A.") }}
MX-Einträge   : {{ result.dns_checks.mx_records | join(", ") if result.dns_checks.mx_records else ("Fehler (" ~ result.dns_checks.mx_error ~ ")" if result.dns_checks.mx_error else "keine") }}
SPF-Eintrag   : {{ "vorhanden" if result.dns_checks.spf_present is sameas true else ("nicht gefunden" if result.dns_checks.spf_present is sameas false else ("Fehler (" ~ result.dns_checks.spf_error ~ ")" if result.dns_checks.spf_error else "unbekannt")) }}
Blocklisten   : {{ result.dns_checks.blocklist_hits | join(", ") if result.dns_checks.blocklist_hits else ("Fehler (" ~ result.dns_checks.blocklist_error ~ ")" if result.dns_checks.blocklist_error else "keine Treffer") }}

=== Body-Analyse ===
URLs:
{% if result.body_indicators.urls -%}
{% for url in result.body_indicators.urls %}- {{ url }}
{% endfor -%}
{% else -%}
- keine
{% endif %}

Domains:
{% if result.body_indicators.domains -%}
{% for dom in result.body_indicators.domains %}- {{ dom }}
{% endfor -%}
{% else -%}
- keine
{% endif %}

IPs:
{% if result.body_indicators.ips -%}
{% for ip in result.body_indicators.ips %}- {{ ip }}
{% endfor -%}
{% else -%}
- keine
{% endif %}

=== Link-Betreiber ===
{% if result.body_link_details -%}
{% for detail in result.body_link_details %}- {{ detail.domain or detail.url }}
  Aufgelöste IPs: {{ detail.resolved_ips | join(", ") or "k. A." }}
  Registrar: {{ detail.domain_record.registrar if detail.domain_record and detail.domain_record.registrar else "k. A." }}
  IP-Betreiber: {{ detail.ip_owner_names | join(", ") if detail.ip_owner_names else "k. A." }}
  {{ "Warnung: HTTP-Link ohne TLS" if not detail.uses_https else "" }}

{% endfor -%}
{% else -%}
- keine
{% endif %}

=== Authentifizierung ===
SPF  : {{ result.auth_summary.spf.result or "unbekannt" }} ({{ result.auth_summary.spf.identity or result.auth_summary.spf.detail or "n/v" }})
DKIM : {{ result.auth_summary.dkim.result or "unbekannt" }} ({{ result.auth_summary.dkim.identity or result.auth_summary.dkim.detail or "n/v" }})
DMARC: {{ result.auth_summary.dmarc.result or "unbekannt" }} ({{ result.auth_summary.dmarc.identity or result.auth_summary.dmarc.detail or "n/v" }})

=== Abuse-Kontakte ===
{% if contacts -%}
{% for contact in contacts %}- {{ contact.address }} (Vertrauen {{ "%0.0f"|format(contact.confidence * 100) }} %)
{% endfor -%}
{% else -%}
- keine ermittelt
{% endif %}
