=== En-têtes complets ===
{% for line in metadata.raw_headers -%}
{{ line }}
{% endfor %}

=== Analyse des en-têtes ===
Objet        : {{ metadata.subject }}
Expéditeur   : {{ metadata.sender }}
Destinataire : {{ metadata.recipient }}
Date         : {{ metadata.date or "inconnue" }}
IP suspecte  : {{ result.candidate_ip or "non déterminée" }}
Opérateur    : {{ (rdap.owner.name if rdap and rdap.owner else "inconnu") }}
Registrar    : {{ domain.registrar if domain and domain.registrar else "n/a" }}

Chaîne Received :
{% if result.received_hops -%}
{% for hop in result.received_hops %}- {{ hop.raw }}
{% endfor -%}
{% else -%}
- aucune
{% endif %}

=== Vérifications DNS / MX ===
Reverse DNS   : {{ result.dns_checks.reverse_dns if result.dns_checks.reverse_dns else ("erreur (" ~ result.dns_checks.reverse_error ~ ")" if result.dns_checks.reverse_error else "n/a") }}
MX            : {{ result.dns_checks.mx_records | join(", ") if result.dns_checks.mx_records else ("erreur (" ~ result.dns_checks.mx_error ~ ")" if result.dns_checks.mx_error else "aucun") }}
Enregistrement SPF : {{ "présent" if result.dns_checks.spf_present is sameas true else ("absent" if result.dns_checks.spf_present is sameas false else ("erreur (" ~ result.dns_checks.spf_error ~ ")" if result.dns_checks.spf_error else "inconnu")) }}
Listes noires : {{ result.dns_checks.blocklist_hits | join(", ") if result.dns_checks.blocklist_hits else ("erreur (" ~ result.dns_checks.blocklist_error ~ ")" if result.dns_checks.blocklist_error else "aucune") }}

=== Analyse du corps ===
URLs :
{% if result.body_indicators.urls -%}
{% for url in result.body_indicators.urls %}- {{ url }}
{% endfor -%}
{% else -%}
- aucune
{% endif %}

Domaines :
{% if result.body_indicators.domains -%}
{% for dom in result.body_indicators.domains %}- {{ dom }}
{% endfor -%}
{% else -%}
- aucun
{% endif %}

Adresses IP :
{% if result.body_indicators.ips -%}
{% for ip in result.body_indicators.ips %}- {{ ip }}
{% endfor -%}
{% else -%}
- aucune
{% endif %}

=== Hébergeurs des liens ===
{% if result.body_link_details -%}
{% for detail in result.body_link_details %}- {{ detail.domain or detail.url }}
  IP résolues : {{ detail.resolved_ips | join(", ") or "n/a" }}
  Registrar   : {{ detail.domain_record.registrar if detail.domain_record and detail.domain_record.registrar else "n/a" }}
  Propriétaires IP : {{ detail.ip_owner_names | join(", ") if detail.ip_owner_names else "n/a" }}
  {{ "Avertissement : lien HTTP sans TLS" if not detail.uses_https else "" }}

{% endfor -%}
{% else -%}
- aucun lien détecté
{% endif %}

=== Authentification ===
SPF  : {{ result.auth_summary.spf.result or "inconnu" }} ({{ result.auth_summary.spf.identity or result.auth_summary.spf.detail or "n/a" }})
DKIM : {{ result.auth_summary.dkim.result or "inconnu" }} ({{ result.auth_summary.dkim.identity or result.auth_summary.dkim.detail or "n/a" }})
DMARC: {{ result.auth_summary.dmarc.result or "inconnu" }} ({{ result.auth_summary.dmarc.identity or result.auth_summary.dmarc.detail or "n/a" }})

=== Contacts à prévenir ===
{% if contacts -%}
{% for contact in contacts %}- {{ contact.address }} (confiance {{ "%0.0f"|format(contact.confidence * 100) }} %)
{% endfor -%}
{% else -%}
- aucun contact détecté
{% endif %}
