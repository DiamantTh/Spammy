=== Encabezados completos ===
{% for line in metadata.raw_headers -%}
{{ line }}
{% endfor %}

=== Análisis de encabezados ===
Asunto        : {{ metadata.subject }}
Remitente     : {{ metadata.sender }}
Destinatario  : {{ metadata.recipient }}
Fecha         : {{ metadata.date or "sin datos" }}
IP sospechosa : {{ result.candidate_ip or "no determinada" }}
Operador      : {{ (rdap.owner.name if rdap and rdap.owner else "desconocido") }}
Registrador   : {{ domain.registrar if domain and domain.registrar else "s/d" }}

Cadena Received:
{% if result.received_hops -%}
{% for hop in result.received_hops %}- {{ hop.raw }}
{% endfor -%}
{% else -%}
- ninguna
{% endif %}

=== Verificaciones DNS / MX ===
Reverse DNS   : {{ result.dns_checks.reverse_dns if result.dns_checks.reverse_dns else ("error (" ~ result.dns_checks.reverse_error ~ ")" if result.dns_checks.reverse_error else "n/d") }}
Registros MX  : {{ result.dns_checks.mx_records | join(", ") if result.dns_checks.mx_records else ("error (" ~ result.dns_checks.mx_error ~ ")" if result.dns_checks.mx_error else "ninguno") }}
Registro SPF  : {{ "presente" if result.dns_checks.spf_present is sameas true else ("no encontrado" if result.dns_checks.spf_present is sameas false else ("error (" ~ result.dns_checks.spf_error ~ ")" if result.dns_checks.spf_error else "desconocido")) }}
Listas negras : {{ result.dns_checks.blocklist_hits | join(", ") if result.dns_checks.blocklist_hits else ("error (" ~ result.dns_checks.blocklist_error ~ ")" if result.dns_checks.blocklist_error else "sin coincidencias") }}

=== Análisis del cuerpo ===
URLs:
{% if result.body_indicators.urls -%}
{% for url in result.body_indicators.urls %}- {{ url }}
{% endfor -%}
{% else -%}
- ninguna
{% endif %}

Dominios:
{% if result.body_indicators.domains -%}
{% for dom in result.body_indicators.domains %}- {{ dom }}
{% endfor -%}
{% else -%}
- ninguno
{% endif %}

IPs:
{% if result.body_indicators.ips -%}
{% for ip in result.body_indicators.ips %}- {{ ip }}
{% endfor -%}
{% else -%}
- ninguna
{% endif %}

=== Operadores de enlaces ===
{% if result.body_link_details -%}
{% for detail in result.body_link_details %}- {{ detail.domain or detail.url }}
  IPs resueltas: {{ detail.resolved_ips | join(", ") or "n/d" }}
  Registrador  : {{ detail.domain_record.registrar if detail.domain_record and detail.domain_record.registrar else "n/d" }}
  Propietarios IP: {{ detail.ip_owner_names | join(", ") if detail.ip_owner_names else "n/d" }}
  {{ "Advertencia: enlace HTTP sin TLS" if not detail.uses_https else "" }}

{% endfor -%}
{% else -%}
- ninguno
{% endif %}

=== Autenticación ===
SPF  : {{ result.auth_summary.spf.result or "desconocido" }} ({{ result.auth_summary.spf.identity or result.auth_summary.spf.detail or "n/d" }})
DKIM : {{ result.auth_summary.dkim.result or "desconocido" }} ({{ result.auth_summary.dkim.identity or result.auth_summary.dkim.detail or "n/d" }})
DMARC: {{ result.auth_summary.dmarc.result or "desconocido" }} ({{ result.auth_summary.dmarc.identity or result.auth_summary.dmarc.detail or "n/d" }})

=== Contactos sugeridos ===
{% if contacts -%}
{% for contact in contacts %}- {{ contact.address }} (confianza {{ "%0.0f"|format(contact.confidence * 100) }} %)
{% endfor -%}
{% else -%}
- ninguno
{% endif %}
